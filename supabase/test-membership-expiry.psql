\echo 'Simulating the expiry-day reminder.'
UPDATE public.profiles
SET membership_status = 'active', membership_expires_at = current_date
WHERE id = :'target_user_id'::uuid;
SELECT COALESCE(max(id), 0) AS response_before FROM net._http_response \gset
INSERT INTO public.notifications (recipient_id, type, title, message, link)
VALUES (
  :'target_user_id'::uuid,
  'membership_expiry',
  'TEST: Membership expires today',
  format('Test reminder. Simulated expiry date: %s.', current_date),
  '/upgrade'
)
RETURNING id AS test_notification_id \gset
\sleep 5
SELECT status_code, content, error_msg
FROM net._http_response
WHERE id > :response_before
ORDER BY id DESC
LIMIT 1;
DELETE FROM public.notifications WHERE id = :'test_notification_id'::uuid;

\echo 'Simulating expiry and checking downgraded access.'
UPDATE public.profiles
SET membership_status = 'active', membership_expires_at = current_date - 1
WHERE id = :'target_user_id'::uuid;
UPDATE public.profiles
SET membership_status = 'lapsed'
WHERE id = :'target_user_id'::uuid
  AND membership_status = 'active'
  AND membership_tier <> 'observer'
  AND membership_expires_at < current_date;

SELECT id, membership_status, membership_expires_at,
       public.current_tier(id) AS effective_tier,
       public.is_active_member(id) AS has_active_access
FROM public.profiles
WHERE id = :'target_user_id'::uuid;